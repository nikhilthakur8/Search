# Self-hosted Meilisearch (replaces MongoDB Atlas Search)
MEILI_HOST=https://meilisearch.clouly.in
MEILI_INDEX=leetcode_users

# Scoped, index-limited API keys. Server-side only - never NEXT_PUBLIC_.
MEILI_SEARCH_KEY=<read-only search key>
MEILI_WRITE_KEY=<write key, used by /api/add-me and /api/leetcode-profile>

NEXT_PUBLIC_BASE_URL=https://search.nextleet.com
